# Copy this file to .env.local and fill in the values from
# Firebase console > Project settings > Your apps > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Localhost only: an App Check debug token. Register it in Firebase console > App Check > Apps > Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
# reCAPTCHA Enterprise site key used by App Check on the deployed site.
VITE_RECAPTCHA_SITE_KEY=
