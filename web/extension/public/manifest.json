{
  "manifest_version": 3,
  "name": "Sus: quiz me on this page",
  "short_name": "Sus",
  "version": "1.0.0",
  "description": "Turn any page, PDF or selection into a 'spot the lie' study game. Runs on-device with Gemini Nano: the page never leaves your browser.",
  "minimum_chrome_version": "139",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Quiz me on this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "contextMenus", "activeTab", "scripting", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://sus-study-game.web.app/*", "https://sus-study-game.firebaseapp.com/*", "http://localhost:5173/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
